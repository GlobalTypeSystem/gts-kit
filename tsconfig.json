{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "paths": {
      "@gts-viewer/shared": ["./packages/shared/dist"],
      "@gts-viewer/shared/*": ["./packages/shared/dist/*"],
      "@gts-viewer/ui": ["./packages/ui/dist"],
      "@gts-viewer/ui/*": ["./packages/ui/dist/*"]
    }
  }
}
